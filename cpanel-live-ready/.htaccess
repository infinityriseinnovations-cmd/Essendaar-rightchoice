# ====================================================================
# Essendaar Suppliers & Facility Care - cPanel .htaccess
# ====================================================================

# 1. Prioritize index.html so the full interactive storefront loads immediately
DirectoryIndex index.html index.php

# 2. Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# Ensure Authorization Header is passed to PHP (Apache strips this by default for Basic Auth & Application Passwords)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Forward WordPress REST API requests directly to index.php
RewriteRule ^wp-json/(.*) index.php?rest_route=/$1 [L,QSA]
RewriteRule ^wp-json$ index.php?rest_route=/ [L,QSA]

# Allow direct access to WordPress admin, login, uploads, and php files
RewriteCond %{REQUEST_URI} ^/wp-(admin|login|content|includes) [NC,OR]
RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteRule ^ - [L]

# 3. Safe HTTPS Redirection (Safe for cPanel multi-domain & Cloudflare/LiteSpeed SSL proxies)
RewriteCond %{HTTPS} !on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 4. GZIP / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# 6. Clean SPA Route Fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
